# Examples only. Copy to .env locally; never commit credentials or access lists.
# These are not loaded automatically: export them in your shell/runtime.
DEFENDER_GCP_PROJECT=your-project-id
DEFENDER_GCP_PROJECT_NUMBER=123456789012
DEFENDER_GCS_BUCKET=your-private-dataset-bucket
DEFENDER_IAP_AUDIENCE=/projects/123456789012/locations/us-west1/services/your-service
ALLOWED_EMAILS=reviewer@example.test
REVIEWER_EMAILS=reviewer@example.test
TRAINING_ENABLED=false
DEFENDER_FIREBASE_PROJECT=your-static-backup-project
# Optional JSON object reference from your verified release upload:
# DEFENDER_DATASET_REF='{"bytes":100,"generation":"1","object":"training/v1/releases/core_aaaaaaaaaaaaaaaa/core.npz","sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}'
# DEFENDER_PUBLIC_RESULT=/absolute/path/to/your/reviewed/result.json
# CLOUDFLARE_ACCOUNT_ID=your-account-id

# FROZEN_MODEL_DIR=/absolute/path/to/verified/frozen-v1
# Optional website-to-Coordinator link; the target must require IAM authentication.
# COPILOT_BACKEND_URL=https://your-coordinator-service.run.app
# Agent containers only: point to your protected operator configuration.
# COPILOT_CONFIG=/workspace/config/config.json
# COPILOT_ROLE=coordinator
# DEFENDER_REVIEWER_MONTHLY_API_LIMIT=150
